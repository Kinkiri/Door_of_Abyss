[resource]
script = ExtResource("s_level")
LevelName = "2-6 苦行圣殿（Boss）"
Description = "圣殿尽头，苦行大主教端坐于寒冰王座。它的光环每回合削弱你一次，还会不断召唤信徒——这是最后的试炼，准备好长线作战了吗。"
Waves = Array[Object]([SubResource("Resource_wave0"), SubResource("Resource_wave1"), SubResource("Resource_wave2"), SubResource("Resource_wave3"), SubResource("Resource_wave4")])
MapData = ExtResource("r_map")
DoorPlaceZoneMin = Vector2i(5, 10)
DoorPlaceZoneMax = Vector2i(7, 11)
DefaultSpawnAreaMin = Vector2i(4, 0)
DefaultSpawnAreaMax = Vector2i(8, 1)
LevelDeck = ExtResource("r_deck")
Hints = Array[Object]([SubResource("Resource_2fmpb")])
AiLevel = 2
BgmKey = "boss"
metadata/_custom_type_script = "uid://wk0covoailum"
