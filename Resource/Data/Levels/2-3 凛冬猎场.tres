[resource]
script = ExtResource("s_level")
LevelName = "2-3 凛冬猎场"
Description = "修会的试炼猎场。每一回合，成群的苦修猎犬都会从四面八方涌入——这是属于清场者的舞台。（超级大堵车）"
Waves = Array[Object]([SubResource("Resource_wave0"), SubResource("Resource_wave1"), SubResource("Resource_wave2"), SubResource("Resource_wave3"), SubResource("Resource_wave4"), SubResource("Resource_wave5"), SubResource("Resource_wave6"), SubResource("Resource_wave7"), SubResource("Resource_wave8"), SubResource("Resource_wave9"), SubResource("Resource_wave10")])
MapData = ExtResource("r_map")
DoorPlaceZoneMin = Vector2i(5, 9)
DoorPlaceZoneMax = Vector2i(7, 11)
DefaultSpawnAreaMin = Vector2i(5, 0)
DefaultSpawnAreaMax = Vector2i(7, 1)
LevelDeck = SubResource("Resource_nfduc")
Hints = Array[Object]([SubResource("Resource_hint0"), SubResource("Resource_hint1"), SubResource("Resource_hint2")])
metadata/_custom_type_script = "uid://wk0covoailum"
