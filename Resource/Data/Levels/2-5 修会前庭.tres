[sub_resource type="Resource" id="Resource_hint0"]
script = ExtResource("s_hint")
Message = "前庭三路进兵。凛冬巨人受击会减速攻击者——让高攻单位站在霜沼里打它，或直接变羊。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint1"]
script = ExtResource("s_hint")
TriggerRound = 4
Message = "敌人从三路轮番施压。用禁魔领域封锁一路，把火力集中在另一路。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint2"]
script = ExtResource("s_hint")
TriggerRound = 8
Message = "精英成团：巨人+骑士+祭司。枷锁叠加（枷锁术/裁判官/惩罚法典）能让它们的攻击力归零。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

