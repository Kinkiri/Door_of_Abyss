[sub_resource type="Resource" id="Resource_hint0"]
script = ExtResource("s_hint")
Message = "回廊窄道是交火的绝地。苦行长老登场会为全场敌方附加强壮——用戒律裁决/禁魔领域拆掉增益。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint1"]
script = ExtResource("s_hint")
TriggerRound = 4
Message = "狡诈的敌人会绕路：它们会从顶部横穿到任何一条通道。在交叉口布下霜沼减速。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint2"]
script = ExtResource("s_hint")
TriggerRound = 8
Message = "惩戒骑士与祭司的组合攻高血厚——集中火力逐一点杀，别让它们形成包围。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

