[resource]
script = ExtResource("s_level")
LevelName = "2-4 戒律回廊"
Description = "修会的戒律回廊，四条窄道通向圣殿深处。苦行长老在此鼓舞同袍——驱散它们，回廊自会安静。"
Waves = Array[Object]([SubResource("Resource_wave0"), SubResource("Resource_wave1"), SubResource("Resource_wave2"), SubResource("Resource_wave3"), SubResource("Resource_wave4")])
MapData = ExtResource("r_map")
DoorPlaceZoneMin = Vector2i(0, 10)
DoorPlaceZoneMax = Vector2i(2, 11)
DefaultSpawnAreaMin = Vector2i(10, 0)
DefaultSpawnAreaMax = Vector2i(12, 2)
LevelDeck = ExtResource("r_deck")
Hints = Array[Object]([SubResource("Resource_hint0"), SubResource("Resource_hint1"), SubResource("Resource_hint2")])
AiLevel = 2
metadata/_custom_type_script = "uid://wk0covoailum"
