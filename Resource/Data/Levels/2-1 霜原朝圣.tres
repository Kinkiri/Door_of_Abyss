[sub_resource type="Resource" id="Resource_hint0"]
script = ExtResource("s_hint")
Message = "欢迎来到霜原。禁欲修会的信徒会径直扑向你的门——用卡牌削弱它们的攻击力，会让防守轻松得多。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint1"]
script = ExtResource("s_hint")
TriggerRound = 2
Message = "苦工虽然孱弱，数量不容小觑。范围伤害（凛冬祭坛、戒律裁决）能一次清掉一群。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint2"]
script = ExtResource("s_hint")
TriggerRound = 6
Message = "执鞭者的攻击会令你的单位攻击力-1——优先解决它，或先用缴械让它哑火。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_wave0"]
script = ExtResource("s_wave")
Round = 2
SpawnAreaMin = Vector2i(8, 0)
SpawnAreaMax = Vector2i(12, 4)
UnitDatas = Array[Object]([ExtResource("r_霜原苦工"), ExtResource("r_霜原苦工"), ExtResource("r_霜原苦工")])
metadata/_custom_type_script = "uid://hrjjaa0stxx1"

