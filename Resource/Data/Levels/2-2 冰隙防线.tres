[sub_resource type="Resource" id="Resource_hint0"]
script = ExtResource("s_hint")
Message = "冰墙把战场一分为二，只有（6,3）与（6,8）两处裂隙可以通行。守住裂隙，敌人就进不来。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint1"]
script = ExtResource("s_hint")
TriggerRound = 4
Message = "霜缚祭司在远处放冷箭还会削你的行动点——让远程单位（缄默圣女/锁链卫兵）先手压制它。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

[sub_resource type="Resource" id="Resource_hint2"]
script = ExtResource("s_hint")
TriggerRound = 8
Message = "惩戒骑士皮糙肉厚，反伤削弱会让打它的人吃亏。用苦行烙印把它变成路障。"
HoverDuration = 6.0
metadata/_custom_type_script = "uid://cov8agd25nia1"

